<?xml version="1.0" encoding="utf-8"?> <!-- NOSONAR -->
<transitionSet <!-- NOSONAR -->
    xmlns:android="http://schemas.android.com/apk/res/android" <!-- NOSONAR -->
    android:interpolator="@android:interpolator/decelerate_quad"> <!-- NOSONAR -->

    <transitionSet> <!-- NOSONAR -->

        <targets> <!-- NOSONAR -->
            <target android:excludeId="@id/toolbar"/> <!-- NOSONAR -->
        </targets> <!-- NOSONAR -->

        <changeImageTransform/> <!-- NOSONAR -->
        <changeBounds/> <!-- NOSONAR -->
        <arcMotion <!-- NOSONAR -->
            android:minimumHorizontalAngle="15" <!-- NOSONAR -->
            android:minimumVerticalAngle="15"> <!-- NOSONAR -->
        </arcMotion> <!-- NOSONAR -->
        <changeTransform/> <!-- NOSONAR -->

    </transitionSet> <!-- NOSONAR -->

    <transitionSet> <!-- NOSONAR -->

        <targets> <!-- NOSONAR -->
            <target android:targetId="@id/toolbar"/> <!-- NOSONAR -->
        </targets> <!-- NOSONAR -->

        <changeBounds/> <!-- NOSONAR -->
        <changeTransform/> <!-- NOSONAR -->

    </transitionSet> <!-- NOSONAR -->


</transitionSet> <!-- NOSONAR -->