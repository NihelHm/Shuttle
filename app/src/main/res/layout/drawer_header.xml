<?xml version="1.0" encoding="utf-8"?> <!-- NOSONAR -->
<FrameLayout <!-- NOSONAR -->
    xmlns:android="http://schemas.android.com/apk/res/android" <!-- NOSONAR -->
    xmlns:tools="http://schemas.android.com/tools" <!-- NOSONAR -->
    android:layout_width="match_parent" <!-- NOSONAR -->
    android:layout_height="wrap_content" <!-- NOSONAR -->
    android:clickable="true"> <!-- NOSONAR -->

    <FrameLayout <!-- NOSONAR -->
        android:layout_width="match_parent" <!-- NOSONAR -->
        android:layout_height="match_parent" <!-- NOSONAR -->
        android:foreground="#20000000"> <!-- NOSONAR -->

        <ImageView <!-- NOSONAR -->
            android:id="@+id/background_image" <!-- NOSONAR -->
            android:layout_width="match_parent" <!-- NOSONAR -->
            android:layout_height="match_parent" <!-- NOSONAR -->
            android:scaleType="centerCrop" <!-- NOSONAR -->
            tools:background="@color/colorPrimaryDark"/> <!-- NOSONAR -->
    </FrameLayout> <!-- NOSONAR -->

    <FrameLayout <!-- NOSONAR -->
        android:layout_width="match_parent" <!-- NOSONAR -->
        android:layout_height="match_parent" <!-- NOSONAR -->
        android:paddingTop="40dp"> <!-- NOSONAR -->

        <View <!-- NOSONAR -->
            android:layout_width="match_parent" <!-- NOSONAR -->
            android:layout_height="132dp" <!-- NOSONAR -->
            android:layout_gravity="bottom" <!-- NOSONAR -->
            android:background="@drawable/text_protection_scrim_reversed"/> <!-- NOSONAR -->

        <LinearLayout <!-- NOSONAR -->
            android:layout_width="match_parent" <!-- NOSONAR -->
            android:layout_height="match_parent" <!-- NOSONAR -->
            android:orientation="vertical" <!-- NOSONAR -->
            android:paddingBottom="16dp" <!-- NOSONAR -->
            android:paddingLeft="16dp" <!-- NOSONAR -->
            android:paddingRight="16dp"> <!-- NOSONAR -->

            <LinearLayout <!-- NOSONAR -->
                android:layout_width="match_parent" <!-- NOSONAR -->
                android:layout_height="wrap_content" <!-- NOSONAR -->
                android:orientation="horizontal"> <!-- NOSONAR -->

                <com.simplecity.amp_library.ui.views.CircleImageView <!-- NOSONAR -->
                    android:id="@+id/artist_image" <!-- NOSONAR -->
                    android:layout_width="64dp" <!-- NOSONAR -->
                    android:layout_height="64dp" <!-- NOSONAR -->
                    android:elevation="2dp" <!-- NOSONAR -->
                    tools:src="@mipmap/ic_launcher_round"/> <!-- NOSONAR -->

                <TextView <!-- NOSONAR -->
                    android:id="@+id/placeholder_text" <!-- NOSONAR -->
                    android:layout_width="match_parent" <!-- NOSONAR -->
                    android:layout_height="match_parent" <!-- NOSONAR -->
                    android:layout_margin="16dp" <!-- NOSONAR -->
                    android:gravity="center_vertical" <!-- NOSONAR -->
                    android:lines="1" <!-- NOSONAR -->
                    android:maxLines="1" <!-- NOSONAR -->
                    android:shadowColor="#50000000" <!-- NOSONAR -->
                    android:shadowRadius="2" <!-- NOSONAR -->
                    android:textColor="#ffffff" <!-- NOSONAR -->
                    android:textSize="20sp" <!-- NOSONAR -->
                    android:visibility="gone"/> <!-- NOSONAR -->

            </LinearLayout> <!-- NOSONAR -->

            <LinearLayout <!-- NOSONAR -->
                android:layout_width="match_parent" <!-- NOSONAR -->
                android:layout_height="56dp" <!-- NOSONAR -->
                android:layout_gravity="bottom" <!-- NOSONAR -->
                android:gravity="center_vertical" <!-- NOSONAR -->
                android:orientation="vertical"> <!-- NOSONAR -->

                <TextView <!-- NOSONAR -->
                    android:id="@+id/line1" <!-- NOSONAR -->
                    android:layout_width="match_parent" <!-- NOSONAR -->
                    android:layout_height="wrap_content" <!-- NOSONAR -->
                    android:lines="1" <!-- NOSONAR -->
                    android:maxLines="1" <!-- NOSONAR -->
                    android:shadowColor="#50000000" <!-- NOSONAR -->
                    android:shadowRadius="2" <!-- NOSONAR -->
                    android:tag=":aesthetic_ignore" <!-- NOSONAR -->
                    android:textColor="#ffffff" <!-- NOSONAR -->
                    android:textSize="14sp" <!-- NOSONAR -->
                    tools:text="Line 1"/> <!-- NOSONAR -->

                <TextView <!-- NOSONAR -->
                    android:id="@+id/line2" <!-- NOSONAR -->
                    android:layout_width="match_parent" <!-- NOSONAR -->
                    android:layout_height="wrap_content" <!-- NOSONAR -->
                    android:lines="1" <!-- NOSONAR -->
                    android:maxLines="1" <!-- NOSONAR -->
                    android:shadowColor="#50000000" <!-- NOSONAR -->
                    android:shadowRadius="2" <!-- NOSONAR -->
                    android:tag=":aesthetic_ignore" <!-- NOSONAR -->
                    android:textColor="#ffffff" <!-- NOSONAR -->
                    android:textSize="14sp" <!-- NOSONAR -->
                    tools:text="Line 2"/> <!-- NOSONAR -->
            </LinearLayout> <!-- NOSONAR -->
        </LinearLayout> <!-- NOSONAR -->
    </FrameLayout> <!-- NOSONAR -->
</FrameLayout> <!-- NOSONAR -->