<?xml version="1.0" encoding="utf-8"?> <!-- NOSONAR -->
<FrameLayout <!-- NOSONAR -->
    xmlns:android="http://schemas.android.com/apk/res/android" <!-- NOSONAR -->
    android:layout_width="match_parent" <!-- NOSONAR -->
    android:layout_height="56dp" <!-- NOSONAR -->
    android:foreground="?attr/list_selector"> <!-- NOSONAR -->

    <LinearLayout <!-- NOSONAR -->
        android:layout_width="match_parent" <!-- NOSONAR -->
        android:layout_height="wrap_content" <!-- NOSONAR -->
        android:gravity="center_vertical" <!-- NOSONAR -->
        android:orientation="horizontal" <!-- NOSONAR -->
        android:padding="8dp"> <!-- NOSONAR -->

        <com.simplecity.amp_library.ui.views.AestheticTintedImageView <!-- NOSONAR -->
            android:id="@+id/icon" <!-- NOSONAR -->
            android:layout_width="44dp" <!-- NOSONAR -->
            android:layout_height="44dp" <!-- NOSONAR -->
            android:padding="10dp" <!-- NOSONAR -->
            android:src="@drawable/ic_shuffle_24dp"/> <!-- NOSONAR -->

        <TextView <!-- NOSONAR -->
            android:id="@+id/title" <!-- NOSONAR -->
            android:layout_width="0dp" <!-- NOSONAR -->
            android:layout_height="wrap_content" <!-- NOSONAR -->
            android:layout_marginLeft="8dp" <!-- NOSONAR -->
            android:layout_weight="1" <!-- NOSONAR -->
            android:fontFamily="sans-serif" <!-- NOSONAR -->
            android:text="@string/shuffle_all" <!-- NOSONAR -->
            android:textColor="?android:textColorPrimary" <!-- NOSONAR -->
            android:textSize="16sp"/> <!-- NOSONAR -->

    </LinearLayout> <!-- NOSONAR -->

    <View <!-- NOSONAR -->
        android:layout_width="match_parent" <!-- NOSONAR -->
        android:layout_height="1dp" <!-- NOSONAR -->
        android:layout_gravity="bottom" <!-- NOSONAR -->
        android:layout_marginLeft="16dp" <!-- NOSONAR -->
        android:layout_marginRight="16dp" <!-- NOSONAR -->
        android:background="?attr/listDividerColor"/> <!-- NOSONAR -->

</FrameLayout> <!-- NOSONAR -->