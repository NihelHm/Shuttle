<?xml version="1.0" encoding="utf-8"?> <!-- NOSONAR -->
<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" <!-- NOSONAR -->
    xmlns:app="http://schemas.android.com/apk/res-auto" <!-- NOSONAR -->
    xmlns:tools="http://schemas.android.com/tools" <!-- NOSONAR -->
    android:id="@+id/coordinator" <!-- NOSONAR -->
    android:layout_width="match_parent" <!-- NOSONAR -->
    android:layout_height="match_parent" <!-- NOSONAR -->
    tools:context=".ui.screens.main.MainActivity"> <!-- NOSONAR -->

    <android.support.design.widget.AppBarLayout <!-- NOSONAR -->
        android:id="@+id/app_bar" <!-- NOSONAR -->
        android:layout_width="match_parent" <!-- NOSONAR -->
        android:layout_height="@dimen/header_view_height"> <!-- NOSONAR -->

        <android.support.design.widget.CustomCollapsingToolbarLayout <!-- NOSONAR -->
            android:id="@+id/toolbar_layout" <!-- NOSONAR -->
            android:layout_width="match_parent" <!-- NOSONAR -->
            android:layout_height="match_parent" <!-- NOSONAR -->
            android:background="?colorPrimary" <!-- NOSONAR -->
            app:collapsedSubtitleTextAppearance="@style/CollapsedSubtitleAppearance" <!-- NOSONAR -->
            app:collapsedTitleTextAppearance="@style/CollapsingToolbarCollapsedTextAppearance" <!-- NOSONAR -->
            app:contentScrim="?colorPrimary" <!-- NOSONAR -->
            app:expandedSubtitleTextAppearance="@style/ExpandedSubtitleAppearance" <!-- NOSONAR -->
            app:expandedTitleMarginStart="16dp" <!-- NOSONAR -->
            app:expandedTitleTextAppearance="@style/CollapsingToolbarExpandedTextAppearance" <!-- NOSONAR -->
            app:layout_scrollFlags="scroll|exitUntilCollapsed" <!-- NOSONAR -->
            app:scrimAnimationDuration="400" <!-- NOSONAR -->
            app:titleEnabled="true" <!-- NOSONAR -->
            tools:title="At The Drive In"> <!-- NOSONAR -->

            <FrameLayout <!-- NOSONAR -->
                android:layout_width="match_parent" <!-- NOSONAR -->
                android:layout_height="@dimen/header_view_height" <!-- NOSONAR -->
                app:layout_collapseMode="parallax"> <!-- NOSONAR -->

                <ImageView <!-- NOSONAR -->
                    android:id="@+id/background" <!-- NOSONAR -->
                    android:layout_width="match_parent" <!-- NOSONAR -->
                    android:layout_height="match_parent" <!-- NOSONAR -->
                    android:scaleType="centerCrop"/> <!-- NOSONAR -->

                <View <!-- NOSONAR -->
                    android:id="@+id/textProtectionScrim" <!-- NOSONAR -->
                    android:layout_width="match_parent" <!-- NOSONAR -->
                    android:layout_height="196dp" <!-- NOSONAR -->
                    android:background="@drawable/text_protection_scrim" <!-- NOSONAR -->
                    android:visibility="invisible" <!-- NOSONAR -->
                    app:layout_collapseMode="parallax" <!-- NOSONAR -->
                    tools:visibility="visible"/> <!-- NOSONAR -->

                <View <!-- NOSONAR -->
                    android:id="@+id/textProtectionScrim2" <!-- NOSONAR -->
                    android:layout_width="match_parent" <!-- NOSONAR -->
                    android:layout_height="170dp" <!-- NOSONAR -->
                    android:layout_gravity="bottom" <!-- NOSONAR -->
                    android:background="@drawable/text_protection_scrim_reversed" <!-- NOSONAR -->
                    android:visibility="invisible" <!-- NOSONAR -->
                    app:layout_collapseMode="parallax" <!-- NOSONAR -->
                    tools:visibility="visible"/> <!-- NOSONAR -->

            </FrameLayout> <!-- NOSONAR -->

            <android.support.v7.widget.Toolbar <!-- NOSONAR -->
                android:id="@+id/toolbar" <!-- NOSONAR -->
                android:layout_width="match_parent" <!-- NOSONAR -->
                android:layout_height="?attr/actionBarSize" <!-- NOSONAR -->
                android:gravity="center_vertical" <!-- NOSONAR -->
                android:transitionName="toolbar" <!-- NOSONAR -->
                app:layout_collapseMode="pin" <!-- NOSONAR -->
                app:navigationIcon="?attr/homeAsUpIndicator" <!-- NOSONAR -->
                app:transparentBackground="true"/> <!-- NOSONAR -->

            <LinearLayout <!-- NOSONAR -->
                android:id="@+id/contextualToolbarContainer" <!-- NOSONAR -->
                android:layout_width="match_parent" <!-- NOSONAR -->
                android:layout_height="wrap_content" <!-- NOSONAR -->
                android:orientation="vertical" <!-- NOSONAR -->
                app:layout_collapseMode="pin"> <!-- NOSONAR -->

                <com.simplecity.amp_library.ui.views.StatusBarView <!-- NOSONAR -->
                    android:layout_width="match_parent" <!-- NOSONAR -->
                    android:layout_height="wrap_content"/> <!-- NOSONAR -->

                <include <!-- NOSONAR -->
                    android:id="@+id/contextualToolbar" <!-- NOSONAR -->
                    layout="@layout/contextual_toolbar"/> <!-- NOSONAR -->

            </LinearLayout> <!-- NOSONAR -->

        </android.support.design.widget.CustomCollapsingToolbarLayout> <!-- NOSONAR -->

    </android.support.design.widget.AppBarLayout> <!-- NOSONAR -->

    <android.support.v7.widget.RecyclerView <!-- NOSONAR -->
        android:id="@+id/recyclerView" <!-- NOSONAR -->
        android:layout_width="match_parent" <!-- NOSONAR -->
        android:layout_height="match_parent" <!-- NOSONAR -->
        android:clipToPadding="false" <!-- NOSONAR -->
        android:paddingTop="8dp" <!-- NOSONAR -->
        app:layout_behavior="@string/appbar_scrolling_view_behavior" <!-- NOSONAR -->
        tools:listitem="@layout/list_item_image"/> <!-- NOSONAR -->

    <android.support.design.widget.FloatingActionButton <!-- NOSONAR -->
        android:id="@+id/fab" <!-- NOSONAR -->
        android:layout_width="wrap_content" <!-- NOSONAR -->
        android:layout_height="wrap_content" <!-- NOSONAR -->
        android:contentDescription="@string/btn_fab_shuffle" <!-- NOSONAR -->
        android:src="@drawable/ic_shuffle_24dp" <!-- NOSONAR -->
        app:fabSize="normal" <!-- NOSONAR -->
        app:layout_anchor="@id/app_bar" <!-- NOSONAR -->
        app:layout_anchorGravity="bottom|end" <!-- NOSONAR -->
        app:useCompatPadding="true"/> <!-- NOSONAR -->

</android.support.design.widget.CoordinatorLayout> <!-- NOSONAR -->