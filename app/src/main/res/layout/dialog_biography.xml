<?xml version="1.0" encoding="utf-8"?> <!-- NOSONAR -->
<FrameLayout <!-- NOSONAR -->
    xmlns:android="http://schemas.android.com/apk/res/android" <!-- NOSONAR -->
    android:layout_width="match_parent" <!-- NOSONAR -->
    android:layout_height="match_parent" <!-- NOSONAR -->
    android:paddingBottom="16dp" <!-- NOSONAR -->
    android:paddingLeft="24dp" <!-- NOSONAR -->
    android:paddingRight="24dp" <!-- NOSONAR -->
    android:paddingTop="16dp"> <!-- NOSONAR -->

    <ScrollView <!-- NOSONAR -->
        android:id="@+id/scrollView" <!-- NOSONAR -->
        android:layout_width="match_parent" <!-- NOSONAR -->
        android:layout_height="match_parent"> <!-- NOSONAR -->

        <TextView <!-- NOSONAR -->
            android:id="@+id/message" <!-- NOSONAR -->
            android:layout_width="match_parent" <!-- NOSONAR -->
            android:layout_height="wrap_content" <!-- NOSONAR -->
            android:textSize="16sp"/> <!-- NOSONAR -->
    </ScrollView> <!-- NOSONAR -->

    <ProgressBar <!-- NOSONAR -->
        android:id="@+id/progress" <!-- NOSONAR -->
        android:layout_width="64dp" <!-- NOSONAR -->
        android:layout_height="64dp" <!-- NOSONAR -->
        android:layout_gravity="center" <!-- NOSONAR -->
        android:indeterminate="true"/> <!-- NOSONAR -->

</FrameLayout> <!-- NOSONAR -->