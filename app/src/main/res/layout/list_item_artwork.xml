<?xml version="1.0" encoding="utf-8"?> <!-- NOSONAR -->
<FrameLayout <!-- NOSONAR -->
    xmlns:android="http://schemas.android.com/apk/res/android" <!-- NOSONAR -->
    xmlns:tools="http://schemas.android.com/tools" <!-- NOSONAR -->
    android:layout_width="240dp" <!-- NOSONAR -->
    android:layout_height="240dp" <!-- NOSONAR -->
    android:background="#10000000"> <!-- NOSONAR -->

    <ImageView <!-- NOSONAR -->
        android:id="@+id/imageView" <!-- NOSONAR -->
        android:layout_width="240dp" <!-- NOSONAR -->
        android:layout_height="240dp" <!-- NOSONAR -->
        android:layout_gravity="center" <!-- NOSONAR -->
        android:scaleType="fitCenter" <!-- NOSONAR -->
        tools:background="@mipmap/ic_launcher"/> <!-- NOSONAR -->

    <ProgressBar <!-- NOSONAR -->
        android:id="@+id/progressBar" <!-- NOSONAR -->
        android:layout_width="48dp" <!-- NOSONAR -->
        android:layout_height="48dp" <!-- NOSONAR -->
        android:layout_gravity="center" <!-- NOSONAR -->
        android:indeterminate="true"/> <!-- NOSONAR -->

    <LinearLayout <!-- NOSONAR -->
        android:id="@+id/textContainer" <!-- NOSONAR -->
        android:layout_width="match_parent" <!-- NOSONAR -->
        android:layout_height="wrap_content" <!-- NOSONAR -->
        android:layout_gravity="bottom" <!-- NOSONAR -->
        android:baselineAligned="false" <!-- NOSONAR -->
        android:gravity="center_vertical" <!-- NOSONAR -->
        android:orientation="horizontal" <!-- NOSONAR -->
        android:paddingBottom="16dp" <!-- NOSONAR -->
        android:paddingLeft="16dp" <!-- NOSONAR -->
        android:paddingRight="8dp" <!-- NOSONAR -->
        android:paddingTop="48dp"> <!-- NOSONAR -->

        <LinearLayout <!-- NOSONAR -->
            android:layout_width="0dp" <!-- NOSONAR -->
            android:layout_height="wrap_content" <!-- NOSONAR -->
            android:layout_weight="1" <!-- NOSONAR -->
            android:gravity="center_vertical" <!-- NOSONAR -->
            android:minHeight="40dp" <!-- NOSONAR -->
            android:orientation="vertical"> <!-- NOSONAR -->

            <TextView <!-- NOSONAR -->
                android:id="@+id/line_one" <!-- NOSONAR -->
                android:layout_width="match_parent" <!-- NOSONAR -->
                android:layout_height="wrap_content" <!-- NOSONAR -->
                android:layout_marginBottom="2dp" <!-- NOSONAR -->
                android:ellipsize="end" <!-- NOSONAR -->
                android:maxLines="1" <!-- NOSONAR -->
                android:tag=":aesthetic_ignore" <!-- NOSONAR -->
                android:textColor="#ffffff" <!-- NOSONAR -->
                android:textSize="16sp" <!-- NOSONAR -->
                tools:text="cover.jpeg"/> <!-- NOSONAR -->

            <TextView <!-- NOSONAR -->
                android:id="@+id/line_two" <!-- NOSONAR -->
                style="?attr/secondaryTextViewStyle" <!-- NOSONAR -->
                android:layout_width="match_parent" <!-- NOSONAR -->
                android:layout_height="wrap_content" <!-- NOSONAR -->
                android:ellipsize="end" <!-- NOSONAR -->
                android:gravity="center_vertical" <!-- NOSONAR -->
                android:maxLines="1" <!-- NOSONAR -->
                android:tag=":aesthetic_ignore" <!-- NOSONAR -->
                android:textColor="#ffffff" <!-- NOSONAR -->
                android:textSize="12sp" <!-- NOSONAR -->
                tools:text="500x500px"/> <!-- NOSONAR -->
        </LinearLayout> <!-- NOSONAR -->

        <FrameLayout <!-- NOSONAR -->
            android:id="@+id/checkView" <!-- NOSONAR -->
            android:layout_width="36dp" <!-- NOSONAR -->
            android:layout_height="36dp" <!-- NOSONAR -->
            android:background="@drawable/circle" <!-- NOSONAR -->
            android:visibility="gone" <!-- NOSONAR -->
            tools:visibility="visible"> <!-- NOSONAR -->

            <ImageView <!-- NOSONAR -->
                android:layout_width="match_parent" <!-- NOSONAR -->
                android:layout_height="match_parent" <!-- NOSONAR -->
                android:layout_gravity="center" <!-- NOSONAR -->
                android:layout_margin="8dp" <!-- NOSONAR -->
                android:src="@drawable/ic_check_24dp"/> <!-- NOSONAR -->

        </FrameLayout> <!-- NOSONAR -->
    </LinearLayout> <!-- NOSONAR -->

</FrameLayout> <!-- NOSONAR -->
