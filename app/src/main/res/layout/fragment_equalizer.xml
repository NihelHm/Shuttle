        android:paddingLeft="@dimen/equalizer_activity_edge_padding" <!-- NOSONAR -->
        android:paddingRight="@dimen/equalizer_activity_edge_padding" <!-- NOSONAR -->
        android:paddingTop="@dimen/equalizer_activity_top_padding"> <!-- NOSONAR -->

        <TextView <!-- NOSONAR -->
