                            android:layout_width="match_parent" <!-- NOSONAR -->
                            android:layout_height="wrap_content" <!-- NOSONAR -->
                            android:layout_toLeftOf="@+id/EqBand1RightTextView" <!-- NOSONAR -->
                            android:layout_toRightOf="@+id/EqBand1LeftTextView"/> <!-- NOSONAR -->

                        <TextView <!-- NOSONAR -->
                            android:id="@+id/EqBand1LeftTextView" <!-- NOSONAR -->
                            android:layout_width="wrap_content" <!-- NOSONAR -->
                            android:layout_height="wrap_content" <!-- NOSONAR -->
                            android:layout_centerVertical="true" <!-- NOSONAR -->
                            android:text="-15db" <!-- NOSONAR -->
                            android:textSize="14sp"/> <!-- NOSONAR -->

                        <TextView <!-- NOSONAR -->
                            android:id="@+id/EqBand1RightTextView" <!-- NOSONAR -->
                            android:layout_width="wrap_content" <!-- NOSONAR -->
                            android:layout_height="wrap_content" <!-- NOSONAR -->
                            android:layout_alignParentRight="true" <!-- NOSONAR -->
                            android:layout_centerVertical="true" <!-- NOSONAR -->
                            android:text="+15db" <!-- NOSONAR -->
                            android:textSize="14sp"/> <!-- NOSONAR -->
                    </RelativeLayout> <!-- NOSONAR -->

                    <TextView <!-- NOSONAR -->
                        android:id="@+id/EqBand1TopTextView" <!-- NOSONAR -->
                        android:layout_width="wrap_content" <!-- NOSONAR -->
                        android:layout_height="wrap_content" <!-- NOSONAR -->
                        android:layout_centerHorizontal="true" <!-- NOSONAR -->
                        android:textSize="14sp"/> <!-- NOSONAR -->
                </RelativeLayout> <!-- NOSONAR -->

                <RelativeLayout <!-- NOSONAR -->
                    android:layout_width="match_parent" <!-- NOSONAR -->
                    android:layout_height="wrap_content" <!-- NOSONAR -->
                    android:layout_marginBottom="4dp" <!-- NOSONAR -->
                    android:layout_marginTop="4dp"> <!-- NOSONAR -->

                    <RelativeLayout <!-- NOSONAR -->
                        android:layout_width="match_parent" <!-- NOSONAR -->
                        android:layout_height="wrap_content" <!-- NOSONAR -->
                        android:layout_alignParentLeft="true" <!-- NOSONAR -->
                        android:layout_alignParentRight="true" <!-- NOSONAR -->
                        android:layout_below="@+id/EqBand2TopTextView"> <!-- NOSONAR -->

                        <com.simplecity.amp_library.ui.views.SizableSeekBar <!-- NOSONAR -->
                            android:id="@+id/EqBand2SeekBar" <!-- NOSONAR -->
                            style="@style/SeekBar" <!-- NOSONAR -->
                            android:layout_width="match_parent" <!-- NOSONAR -->
                            android:layout_height="wrap_content" <!-- NOSONAR -->
                            android:layout_toLeftOf="@+id/EqBand2RightTextView" <!-- NOSONAR -->
                            android:layout_toRightOf="@+id/EqBand2LeftTextView"/> <!-- NOSONAR -->

                        <TextView <!-- NOSONAR -->
                            android:id="@+id/EqBand2LeftTextView" <!-- NOSONAR -->
                            android:layout_width="wrap_content" <!-- NOSONAR -->
                            android:layout_height="wrap_content" <!-- NOSONAR -->
                            android:layout_centerVertical="true" <!-- NOSONAR -->
                            android:text="-15db" <!-- NOSONAR -->
                            android:textSize="14sp" <!-- NOSONAR -->

                            /> <!-- NOSONAR -->

                        <TextView <!-- NOSONAR -->
                            android:id="@+id/EqBand2RightTextView" <!-- NOSONAR -->
                            android:layout_width="wrap_content" <!-- NOSONAR -->
                            android:layout_height="wrap_content" <!-- NOSONAR -->
                            android:layout_alignParentRight="true" <!-- NOSONAR -->
                            android:layout_centerVertical="true" <!-- NOSONAR -->
                            android:text="+15db" <!-- NOSONAR -->
                            android:textSize="14sp"/> <!-- NOSONAR -->
                    </RelativeLayout> <!-- NOSONAR -->

                    <TextView <!-- NOSONAR -->
                        android:id="@+id/EqBand2TopTextView" <!-- NOSONAR -->
                        android:layout_width="wrap_content" <!-- NOSONAR -->
                        android:layout_height="wrap_content" <!-- NOSONAR -->
                        android:layout_centerHorizontal="true" <!-- NOSONAR -->
                        android:textSize="14sp"/> <!-- NOSONAR -->
                </RelativeLayout> <!-- NOSONAR -->

                <RelativeLayout <!-- NOSONAR -->
                    android:layout_width="match_parent" <!-- NOSONAR -->
                    android:layout_height="wrap_content" <!-- NOSONAR -->
                    android:layout_marginBottom="4dp" <!-- NOSONAR -->
                    android:layout_marginTop="4dp"> <!-- NOSONAR -->

                    <RelativeLayout <!-- NOSONAR -->
                        android:layout_width="match_parent" <!-- NOSONAR -->
                        android:layout_height="wrap_content" <!-- NOSONAR -->
                        android:layout_alignParentLeft="true" <!-- NOSONAR -->
                        android:layout_alignParentRight="true" <!-- NOSONAR -->
                        android:layout_below="@+id/EqBand3TopTextView"> <!-- NOSONAR -->

                        <com.simplecity.amp_library.ui.views.SizableSeekBar <!-- NOSONAR -->
                            android:id="@+id/EqBand3SeekBar" <!-- NOSONAR -->
                            style="@style/SeekBar" <!-- NOSONAR -->
                            android:layout_width="match_parent" <!-- NOSONAR -->
                            android:layout_height="wrap_content" <!-- NOSONAR -->
                            android:layout_toLeftOf="@+id/EqBand3RightTextView" <!-- NOSONAR -->
                            android:layout_toRightOf="@+id/EqBand3LeftTextView"/> <!-- NOSONAR -->

                        <TextView <!-- NOSONAR -->
                            android:id="@+id/EqBand3LeftTextView" <!-- NOSONAR -->
                            android:layout_width="wrap_content" <!-- NOSONAR -->
                            android:layout_height="wrap_content" <!-- NOSONAR -->
                            android:layout_centerVertical="true" <!-- NOSONAR -->
                            android:text="-15db" <!-- NOSONAR -->
                            android:textSize="14sp"/> <!-- NOSONAR -->

                        <TextView <!-- NOSONAR -->
                            android:id="@+id/EqBand3RightTextView" <!-- NOSONAR -->
                            android:layout_width="wrap_content" <!-- NOSONAR -->
                            android:layout_height="wrap_content" <!-- NOSONAR -->
                            android:layout_alignParentRight="true" <!-- NOSONAR -->
                            android:layout_centerVertical="true" <!-- NOSONAR -->
                            android:text="+15db" <!-- NOSONAR -->
                            android:textSize="14sp"/> <!-- NOSONAR -->
                    </RelativeLayout> <!-- NOSONAR -->

                    <TextView <!-- NOSONAR -->
                        android:id="@+id/EqBand3TopTextView" <!-- NOSONAR -->
                        android:layout_width="wrap_content" <!-- NOSONAR -->
                        android:layout_height="wrap_content" <!-- NOSONAR -->
                        android:layout_centerHorizontal="true" <!-- NOSONAR -->
                        android:textSize="14sp"/> <!-- NOSONAR -->
                </RelativeLayout> <!-- NOSONAR -->

                <RelativeLayout <!-- NOSONAR -->
                    android:layout_width="match_parent" <!-- NOSONAR -->
                    android:layout_height="wrap_content" <!-- NOSONAR -->
                    android:layout_marginBottom="4dp" <!-- NOSONAR -->
                    android:layout_marginTop="4dp"> <!-- NOSONAR -->

                    <RelativeLayout <!-- NOSONAR -->
                        android:layout_width="match_parent" <!-- NOSONAR -->
                        android:layout_height="wrap_content" <!-- NOSONAR -->
                        android:layout_alignParentLeft="true" <!-- NOSONAR -->
                        android:layout_alignParentRight="true" <!-- NOSONAR -->
                        android:layout_below="@+id/EqBand4TopTextView"> <!-- NOSONAR -->

                        <com.simplecity.amp_library.ui.views.SizableSeekBar <!-- NOSONAR -->
                            android:id="@+id/EqBand4SeekBar" <!-- NOSONAR -->
                            style="@style/SeekBar" <!-- NOSONAR -->
                            android:layout_width="match_parent" <!-- NOSONAR -->
                            android:layout_height="wrap_content" <!-- NOSONAR -->
                            android:layout_toLeftOf="@+id/EqBand4RightTextView" <!-- NOSONAR -->
                            android:layout_toRightOf="@+id/EqBand4LeftTextView"/> <!-- NOSONAR -->

                        <TextView <!-- NOSONAR -->
                            android:id="@+id/EqBand4LeftTextView" <!-- NOSONAR -->
                            android:layout_width="wrap_content" <!-- NOSONAR -->
                            android:layout_height="wrap_content" <!-- NOSONAR -->
                            android:layout_centerVertical="true" <!-- NOSONAR -->
                            android:text="-15db" <!-- NOSONAR -->
                            android:textSize="14sp"/> <!-- NOSONAR -->

                        <TextView <!-- NOSONAR -->
                            android:id="@+id/EqBand4RightTextView" <!-- NOSONAR -->
                            android:layout_width="wrap_content" <!-- NOSONAR -->
                            android:layout_height="wrap_content" <!-- NOSONAR -->
                            android:layout_alignParentRight="true" <!-- NOSONAR -->
                            android:layout_centerVertical="true" <!-- NOSONAR -->
                            android:text="+15db" <!-- NOSONAR -->
                            android:textSize="14sp"/> <!-- NOSONAR -->
                    </RelativeLayout> <!-- NOSONAR -->

                    <TextView <!-- NOSONAR -->
                        android:id="@+id/EqBand4TopTextView" <!-- NOSONAR -->
                        android:layout_width="wrap_content" <!-- NOSONAR -->
                        android:layout_height="wrap_content" <!-- NOSONAR -->
                        android:layout_centerHorizontal="true" <!-- NOSONAR -->
                        android:textSize="14sp"/> <!-- NOSONAR -->
                </RelativeLayout> <!-- NOSONAR -->

                <RelativeLayout <!-- NOSONAR -->
                    android:layout_width="match_parent" <!-- NOSONAR -->
                    android:layout_height="wrap_content" <!-- NOSONAR -->
                    android:layout_marginBottom="4dp" <!-- NOSONAR -->
                    android:layout_marginTop="4dp"> <!-- NOSONAR -->

                    <RelativeLayout <!-- NOSONAR -->
                        android:layout_width="match_parent" <!-- NOSONAR -->
                        android:layout_height="wrap_content" <!-- NOSONAR -->
                        android:layout_alignParentLeft="true" <!-- NOSONAR -->
                        android:layout_alignParentRight="true" <!-- NOSONAR -->
                        android:layout_below="@+id/EqBand5TopTextView"> <!-- NOSONAR -->

                        <com.simplecity.amp_library.ui.views.SizableSeekBar <!-- NOSONAR -->
                            android:id="@+id/EqBand5SeekBar" <!-- NOSONAR -->
                            style="@style/SeekBar" <!-- NOSONAR -->
                            android:layout_width="match_parent" <!-- NOSONAR -->
                            android:layout_height="wrap_content" <!-- NOSONAR -->
                            android:layout_toLeftOf="@+id/EqBand5RightTextView" <!-- NOSONAR -->
                            android:layout_toRightOf="@+id/EqBand5LeftTextView" <!-- NOSONAR -->
                            android:visibility="gone"/> <!-- NOSONAR -->

                        <TextView <!-- NOSONAR -->
                            android:id="@+id/EqBand5LeftTextView" <!-- NOSONAR -->
                            android:layout_width="wrap_content" <!-- NOSONAR -->
                            android:layout_height="wrap_content" <!-- NOSONAR -->
                            android:layout_centerVertical="true" <!-- NOSONAR -->
                            android:text="-15db" <!-- NOSONAR -->
                            android:textSize="14sp" <!-- NOSONAR -->
                            android:visibility="gone"/> <!-- NOSONAR -->

                        <TextView <!-- NOSONAR -->
                            android:id="@+id/EqBand5RightTextView" <!-- NOSONAR -->
                            android:layout_width="wrap_content" <!-- NOSONAR -->
                            android:layout_height="wrap_content" <!-- NOSONAR -->
                            android:layout_alignParentRight="true" <!-- NOSONAR -->
                            android:layout_centerVertical="true" <!-- NOSONAR -->
                            android:text="+15db" <!-- NOSONAR -->
                            android:textSize="14sp" <!-- NOSONAR -->
                            android:visibility="gone"/> <!-- NOSONAR -->
                    </RelativeLayout> <!-- NOSONAR -->

                    <TextView <!-- NOSONAR -->
                        android:id="@+id/EqBand5TopTextView" <!-- NOSONAR -->
                        android:layout_width="wrap_content" <!-- NOSONAR -->
                        android:layout_height="wrap_content" <!-- NOSONAR -->
                        android:layout_centerHorizontal="true" <!-- NOSONAR -->
                        android:textSize="14sp" <!-- NOSONAR -->
                        android:visibility="gone"/> <!-- NOSONAR -->
                </RelativeLayout> <!-- NOSONAR -->
            </LinearLayout> <!-- NOSONAR -->
        </ScrollView> <!-- NOSONAR -->

        <LinearLayout <!-- NOSONAR -->
            android:layout_width="match_parent" <!-- NOSONAR -->
            android:layout_height="wrap_content" <!-- NOSONAR -->
            android:layout_marginBottom="8dp" <!-- NOSONAR -->
            android:layout_marginTop="8dp" <!-- NOSONAR -->
            android:gravity="center_vertical" <!-- NOSONAR -->
            android:orientation="horizontal"> <!-- NOSONAR -->

            <TextView <!-- NOSONAR -->
                android:layout_width="wrap_content" <!-- NOSONAR -->
                android:layout_height="wrap_content" <!-- NOSONAR -->
                android:minEms="8" <!-- NOSONAR -->
                android:text="@string/virtualizer_strength" <!-- NOSONAR -->
                android:textSize="14sp"/> <!-- NOSONAR -->

            <com.simplecity.amp_library.ui.views.SizableSeekBar <!-- NOSONAR -->
                android:id="@+id/virtualizer_strength" <!-- NOSONAR -->
                style="@style/SeekBar" <!-- NOSONAR -->
                android:layout_width="0dp" <!-- NOSONAR -->
                android:layout_height="wrap_content" <!-- NOSONAR -->
                android:layout_weight="1"/> <!-- NOSONAR -->

        </LinearLayout> <!-- NOSONAR -->

        <LinearLayout <!-- NOSONAR -->
            android:layout_width="match_parent" <!-- NOSONAR -->
            android:layout_height="wrap_content" <!-- NOSONAR -->
            android:layout_marginTop="8dp" <!-- NOSONAR -->
            android:gravity="center_vertical" <!-- NOSONAR -->
            android:orientation="horizontal"> <!-- NOSONAR -->

            <TextView <!-- NOSONAR -->
                android:layout_width="wrap_content" <!-- NOSONAR -->
                android:layout_height="wrap_content" <!-- NOSONAR -->
                android:minEms="8" <!-- NOSONAR -->
                android:text="@string/bass_boost_strength" <!-- NOSONAR -->
                android:textSize="14sp"/> <!-- NOSONAR -->

            <com.simplecity.amp_library.ui.views.SizableSeekBar <!-- NOSONAR -->
                android:id="@+id/bb_strength" <!-- NOSONAR -->
                style="@style/SeekBar" <!-- NOSONAR -->
                android:layout_width="0dp" <!-- NOSONAR -->
                android:layout_height="wrap_content" <!-- NOSONAR -->
                android:layout_weight="1"/> <!-- NOSONAR -->

        </LinearLayout> <!-- NOSONAR -->
    </LinearLayout> <!-- NOSONAR -->
</LinearLayout> <!-- NOSONAR -->