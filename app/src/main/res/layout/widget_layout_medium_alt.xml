<?xml version="1.0" encoding="utf-8"?> <!-- NOSONAR -->

<FrameLayout <!-- NOSONAR -->
    xmlns:android="http://schemas.android.com/apk/res/android" <!-- NOSONAR -->
    xmlns:tools="http://schemas.android.com/tools" <!-- NOSONAR -->
    android:id="@+id/widget_layout_medium" <!-- NOSONAR -->
    android:layout_width="match_parent" <!-- NOSONAR -->
    android:layout_height="@dimen/widget_medium_height" <!-- NOSONAR -->
    tools:ignore="ContentDescription"> <!-- NOSONAR -->

    <ImageView <!-- NOSONAR -->
        android:id="@+id/album_art" <!-- NOSONAR -->
        android:layout_width="match_parent" <!-- NOSONAR -->
        android:layout_height="match_parent" <!-- NOSONAR -->
        android:scaleType="centerCrop"/> <!-- NOSONAR -->

    <LinearLayout <!-- NOSONAR -->
        android:layout_width="match_parent" <!-- NOSONAR -->
        android:layout_height="match_parent" <!-- NOSONAR -->
        android:layout_marginBottom="2dp" <!-- NOSONAR -->
        android:orientation="vertical"> <!-- NOSONAR -->

        <LinearLayout <!-- NOSONAR -->
            android:id="@+id/text" <!-- NOSONAR -->
            android:layout_width="match_parent" <!-- NOSONAR -->
            android:layout_height="48dp" <!-- NOSONAR -->
            android:layout_marginTop="2dp" <!-- NOSONAR -->
            android:gravity="center_vertical" <!-- NOSONAR -->
            android:orientation="vertical"> <!-- NOSONAR -->

            <TextView <!-- NOSONAR -->
                android:id="@+id/text1" <!-- NOSONAR -->
                style="@style/AppWidget_TextView.Bold" <!-- NOSONAR -->
                android:layout_width="match_parent" <!-- NOSONAR -->
                android:layout_height="0dp" <!-- NOSONAR -->
                android:layout_marginLeft="8dp" <!-- NOSONAR -->
                android:layout_marginRight="8dp" <!-- NOSONAR -->
                android:layout_weight="1" <!-- NOSONAR -->
                android:ellipsize="end" <!-- NOSONAR -->
                android:gravity="center" <!-- NOSONAR -->
                android:maxLines="1" <!-- NOSONAR -->
                android:textColor="?android:textColorPrimaryInverse" <!-- NOSONAR -->
                android:textSize="14sp"/> <!-- NOSONAR -->

            <TextView <!-- NOSONAR -->
                android:id="@+id/text2" <!-- NOSONAR -->
                style="@style/AppWidget_TextView" <!-- NOSONAR -->
                android:layout_width="match_parent" <!-- NOSONAR -->
                android:layout_height="0dp" <!-- NOSONAR -->
                android:layout_marginLeft="8dp" <!-- NOSONAR -->
                android:layout_marginRight="8dp" <!-- NOSONAR -->
                android:layout_weight="1" <!-- NOSONAR -->
                android:ellipsize="end" <!-- NOSONAR -->
                android:gravity="center" <!-- NOSONAR -->
                android:maxLines="1" <!-- NOSONAR -->
                android:textColor="?android:textColorSecondaryInverse" <!-- NOSONAR -->
                android:textSize="14sp"/> <!-- NOSONAR -->
        </LinearLayout> <!-- NOSONAR -->

        <LinearLayout <!-- NOSONAR -->
            android:id="@id/buttons" <!-- NOSONAR -->
            android:layout_width="match_parent" <!-- NOSONAR -->
            android:layout_height="0dp" <!-- NOSONAR -->
            android:layout_weight="1" <!-- NOSONAR -->
            android:orientation="horizontal"> <!-- NOSONAR -->

            <ImageButton <!-- NOSONAR -->
                android:id="@+id/shuffle_button" <!-- NOSONAR -->
                android:layout_width="0dp" <!-- NOSONAR -->
                android:layout_height="match_parent" <!-- NOSONAR -->
                android:layout_weight="1" <!-- NOSONAR -->
                android:background="@android:color/transparent" <!-- NOSONAR -->
                android:contentDescription="@string/btn_shuffle_on" <!-- NOSONAR -->
                android:src="@drawable/ic_shuffle_24dp_scaled"/> <!-- NOSONAR -->

            <ImageButton <!-- NOSONAR -->
                android:id="@+id/prev_button" <!-- NOSONAR -->
                android:layout_width="0dp" <!-- NOSONAR -->
                android:layout_height="match_parent" <!-- NOSONAR -->
                android:layout_weight="1" <!-- NOSONAR -->
                android:background="@android:color/transparent" <!-- NOSONAR -->
                android:contentDescription="@string/btn_prev" <!-- NOSONAR -->
                android:src="@drawable/ic_skip_previous_24dp"/> <!-- NOSONAR -->

            <ImageButton <!-- NOSONAR -->
                android:id="@+id/play_button" <!-- NOSONAR -->
                android:layout_width="0dp" <!-- NOSONAR -->
                android:layout_height="match_parent" <!-- NOSONAR -->
                android:layout_weight="1" <!-- NOSONAR -->
                android:background="@android:color/transparent" <!-- NOSONAR -->
                android:contentDescription="@string/btn_play_pause" <!-- NOSONAR -->
                android:src="@drawable/ic_play_24dp"/> <!-- NOSONAR -->

            <ImageButton <!-- NOSONAR -->
                android:id="@+id/next_button" <!-- NOSONAR -->
                android:layout_width="0dp" <!-- NOSONAR -->
                android:layout_height="match_parent" <!-- NOSONAR -->
                android:layout_weight="1" <!-- NOSONAR -->
                android:background="@android:color/transparent" <!-- NOSONAR -->
                android:contentDescription="@string/btn_skip" <!-- NOSONAR -->
                android:src="@drawable/ic_skip_next_24dp"/> <!-- NOSONAR -->

            <ImageButton <!-- NOSONAR -->
                android:id="@+id/repeat_button" <!-- NOSONAR -->
                android:layout_width="0dp" <!-- NOSONAR -->
                android:layout_height="match_parent" <!-- NOSONAR -->
                android:layout_weight="1" <!-- NOSONAR -->
                android:background="@android:color/transparent" <!-- NOSONAR -->
                android:contentDescription="@string/btn_repeat_all" <!-- NOSONAR -->
                android:src="@drawable/ic_repeat_24dp_scaled"/> <!-- NOSONAR -->
        </LinearLayout> <!-- NOSONAR -->

    </LinearLayout> <!-- NOSONAR -->
</FrameLayout> <!-- NOSONAR -->