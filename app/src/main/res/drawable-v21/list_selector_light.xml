<?xml version="1.0" encoding="utf-8"?> <!-- NOSONAR -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" <!-- NOSONAR -->
        android:color="@color/ripple_material_light"> <!-- NOSONAR -->
    <item android:drawable="@android:color/transparent"/> <!-- NOSONAR -->

    <item android:id="@android:id/mask"> <!-- NOSONAR -->
        <color android:color="@color/white"/> <!-- NOSONAR -->
    </item> <!-- NOSONAR -->

    <item> <!-- NOSONAR -->
        <selector <!-- NOSONAR -->
            android:exitFadeDuration="@android:integer/config_mediumAnimTime"> <!-- NOSONAR -->

            <item <!-- NOSONAR -->
                android:drawable="@drawable/list_item_activated_light" <!-- NOSONAR -->
                android:state_activated="true"/> <!-- NOSONAR -->

            <item <!-- NOSONAR -->
                android:drawable="@drawable/list_item_activated_light" <!-- NOSONAR -->
                android:state_selected="true"/> <!-- NOSONAR -->

            <item android:drawable="@android:color/transparent"/> <!-- NOSONAR -->
        </selector> <!-- NOSONAR -->
    </item> <!-- NOSONAR -->

</ripple> <!-- NOSONAR -->