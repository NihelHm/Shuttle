    <declare-styleable name="SwitchPreference"> <!-- NOSONAR -->

        <!-- <!-- NOSONAR -->
             The summary for the Preference in a PreferenceActivity screen when the <!-- NOSONAR -->
             SwitchPreference is checked. If separate on/off summaries are not <!-- NOSONAR -->
             needed, the summary attribute can be used instead. <!-- NOSONAR -->
        --> <!-- NOSONAR -->
        <attr name="summaryOn" format="reference"/> <!-- NOSONAR -->
        <!-- <!-- NOSONAR -->
             The summary for the Preference in a PreferenceActivity screen when the <!-- NOSONAR -->
             SwitchPreference is unchecked. If separate on/off summaries are not <!-- NOSONAR -->
             needed, the summary attribute can be used instead. <!-- NOSONAR -->
        --> <!-- NOSONAR -->
        <attr name="summaryOff" format="reference"/> <!-- NOSONAR -->
        <!-- <!-- NOSONAR -->
             The text used on the switch itself when in the "on" state. <!-- NOSONAR -->
             This should be a very SHORT string, as it appears in a small space. <!-- NOSONAR -->
        --> <!-- NOSONAR -->
        <attr name="switchTextOn" format="reference"/> <!-- NOSONAR -->
        <!-- <!-- NOSONAR -->
             The text used on the switch itself when in the "off" state. <!-- NOSONAR -->
             This should be a very SHORT string, as it appears in a small space. <!-- NOSONAR -->
        --> <!-- NOSONAR -->
        <attr name="switchTextOff" format="reference"/> <!-- NOSONAR -->
        <!-- <!-- NOSONAR -->
             The state (true for on, or false for off) that causes dependents to be disabled. By default, <!-- NOSONAR -->
             dependents will be disabled when this is unchecked, so the value of this preference is false. <!-- NOSONAR -->
        --> <!-- NOSONAR -->
        <attr name="disableDependentsState" format="boolean"/> <!-- NOSONAR -->
    </declare-styleable> <!-- NOSONAR -->
