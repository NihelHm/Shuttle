<?xml version="1.0" encoding="utf-8"?> <!-- NOSONAR -->
<resources xmlns:android="http://schemas.android.com/apk/res/android"> <!-- NOSONAR -->

    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar"> <!-- NOSONAR -->

        <item name="colorPrimaryDark">@color/md_grey_600</item> <!-- NOSONAR -->
        <item name="colorPrimary">@color/md_grey_500</item> <!-- NOSONAR -->
        <item name="colorAccent">@color/md_grey_250</item> <!-- NOSONAR -->

        <item name="list_selector">@drawable/list_selector_dark</item> <!-- NOSONAR -->
        <item name="listDividerColor">@color/list_divider_dark</item> <!-- NOSONAR -->
        <item name="circular_ripple">@drawable/ripple_circular_dark</item> <!-- NOSONAR -->

        <item name="preferenceTheme"> <!-- NOSONAR -->
            @style/PreferenceThemeOverlay.v14.Material <!-- NOSONAR -->
        </item> <!-- NOSONAR -->
    </style> <!-- NOSONAR -->

    <style name="AppTheme.Light" parent="Theme.AppCompat.Light.NoActionBar"> <!-- NOSONAR -->

        <item name="colorPrimaryDark">@color/md_grey_600</item> <!-- NOSONAR -->
        <item name="colorPrimary">@color/md_grey_500</item> <!-- NOSONAR -->
        <item name="colorAccent">@color/md_grey_250</item> <!-- NOSONAR -->

        <item name="list_selector">@drawable/list_selector_light</item> <!-- NOSONAR -->
        <item name="listDividerColor">@color/list_divider_light</item> <!-- NOSONAR -->
        <item name="circular_ripple">@drawable/ripple_circular_light</item> <!-- NOSONAR -->
    </style> <!-- NOSONAR -->

    <style name="CarTheme" parent="AppTheme"> <!-- NOSONAR -->
        <item name="colorPrimaryDark">#039BE5</item> <!-- NOSONAR -->
        <item name="colorPrimary">#039BE5</item> <!-- NOSONAR -->
        <item name="colorAccent">#E53935</item> <!-- NOSONAR -->
    </style> <!-- NOSONAR -->

    <style name="AppTheme.Black" parent="AppTheme"> <!-- NOSONAR -->
        <item name="android:windowBackground">@color/black</item> <!-- NOSONAR -->
    </style> <!-- NOSONAR -->

    <style name="TranslucentTheme" parent="Theme.AppCompat"> <!-- NOSONAR -->
        <item name="android:windowIsTranslucent">true</item> <!-- NOSONAR -->
        <item name="android:windowBackground">@color/semitransparent</item> <!-- NOSONAR -->
        <item name="android:windowContentOverlay">@null</item> <!-- NOSONAR -->
        <item name="android:windowNoTitle">true</item> <!-- NOSONAR -->
        <item name="android:windowIsFloating">true</item> <!-- NOSONAR -->
        <item name="android:backgroundDimEnabled">false</item> <!-- NOSONAR -->
    </style> <!-- NOSONAR -->

    <style name="WallpaperTheme" parent="Theme.AppCompat.NoActionBar"> <!-- NOSONAR -->
        <item name="colorPrimaryDark">@color/md_grey_600</item> <!-- NOSONAR -->
        <item name="colorPrimary">@color/md_grey_500</item> <!-- NOSONAR -->
        <item name="colorAccent">@color/md_grey_250</item> <!-- NOSONAR -->
        <item name="android:windowShowWallpaper">true</item> <!-- NOSONAR -->
        <item name="android:windowBackground">@color/transparent</item> <!-- NOSONAR -->
        <item name="android:textColorHighlight">@color/text_highlight</item> <!-- NOSONAR -->
    </style> <!-- NOSONAR -->

    <style name="Theme.AppCompat.NoActionBar.FullScreen" parent="@style/Theme.AppCompat"/> <!-- NOSONAR -->

    <style name="CollapsingToolbarExpandedTextAppearance" parent="TextAppearance.AppCompat.Title"> <!-- NOSONAR -->
        <item name="android:textSize">30sp</item> <!-- NOSONAR -->
        <item name="android:textColor">#fff</item> <!-- NOSONAR -->
    </style> <!-- NOSONAR -->

    <style name="CollapsingToolbarCollapsedTextAppearance" parent="TextAppearance.AppCompat.Medium"> <!-- NOSONAR -->
        <item name="android:textColor">#fff</item> <!-- NOSONAR -->
    </style> <!-- NOSONAR -->

    <style name="CustomCollapsingToolbarLayout" parent="@style/Widget.Design.CollapsingToolbar"/> <!-- NOSONAR -->

    <style name="CollapsedSubtitleAppearance" parent="TextAppearance.AppCompat.Widget.ActionBar.Subtitle"> <!-- NOSONAR -->
        <item name="android:textColor">#fff</item> <!-- NOSONAR -->
    </style> <!-- NOSONAR -->

    <style name="ExpandedSubtitleAppearance" parent="TextAppearance.AppCompat.Headline"> <!-- NOSONAR -->
        <item name="android:textColor">#fff</item> <!-- NOSONAR -->
    </style> <!-- NOSONAR -->

    <style name="SeekBar" parent="android:Widget.SeekBar"> <!-- NOSONAR -->
        <item name="android:progressDrawable">@drawable/scrubber_progress_horizontal_material</item> <!-- NOSONAR -->
        <item name="android:indeterminateDrawable">@drawable/scrubber_progress_horizontal_material <!-- NOSONAR -->
        </item> <!-- NOSONAR -->
        <item name="android:thumb">@drawable/scrubber_control_from_pressed_mtrl_000</item> <!-- NOSONAR -->
        <item name="android:splitTrack">false</item> <!-- NOSONAR -->
        <item name="android:focusable">true</item> <!-- NOSONAR -->
        <item name="android:paddingLeft">16dip</item> <!-- NOSONAR -->
        <item name="android:paddingRight">16dip</item> <!-- NOSONAR -->
        <item name="android:mirrorForRtl">true</item> <!-- NOSONAR -->
        <!--<item name="android:background">?attr/selectableItemBackgroundBorderless</item>--> <!-- NOSONAR -->
    </style> <!-- NOSONAR -->

    <style name="SeekBar.NoBackground"> <!-- NOSONAR -->
        <item name="android:progressDrawable"> <!-- NOSONAR -->
            @drawable/scrubber_progress_horizontal_material_no_background <!-- NOSONAR -->
        </item> <!-- NOSONAR -->
    </style> <!-- NOSONAR -->

    <style name="AppWidget_TextView"> <!-- NOSONAR -->
        <item name="android:fontFamily">sans-serif</item> <!-- NOSONAR -->
    </style> <!-- NOSONAR -->

    <style name="AppWidget_TextView.Bold" parent="AppWidget_TextView"> <!-- NOSONAR -->
        <item name="android:textStyle">bold</item> <!-- NOSONAR -->
    </style> <!-- NOSONAR -->

</resources> <!-- NOSONAR -->