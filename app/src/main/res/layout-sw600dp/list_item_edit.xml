<?xml version="1.0" encoding="utf-8"?> <!-- NOSONAR -->
<android.support.design.internal.ForegroundLinearLayout <!-- NOSONAR -->
    xmlns:android="http://schemas.android.com/apk/res/android" <!-- NOSONAR -->
    android:layout_width="match_parent" <!-- NOSONAR -->
    android:layout_height="48dp" <!-- NOSONAR -->
    android:descendantFocusability="blocksDescendants" <!-- NOSONAR -->
    android:foreground="?attr/list_selector"> <!-- NOSONAR -->

    <ImageView <!-- NOSONAR -->
        android:id="@+id/drag_handle" <!-- NOSONAR -->
        android:layout_width="32dp" <!-- NOSONAR -->
        android:layout_height="match_parent" <!-- NOSONAR -->
        android:layout_marginLeft="8dp" <!-- NOSONAR -->
        android:layout_marginRight="8dp" <!-- NOSONAR -->
        android:alpha="0.5" <!-- NOSONAR -->
        android:paddingLeft="8dp" <!-- NOSONAR -->
        android:paddingRight="8dp" <!-- NOSONAR -->
        android:src="@drawable/ic_drag_grip"/> <!-- NOSONAR -->

    <TextView <!-- NOSONAR -->
        android:id="@+id/line_one" <!-- NOSONAR -->
        android:layout_width="0dp" <!-- NOSONAR -->
        android:layout_height="match_parent" <!-- NOSONAR -->
        android:layout_weight="5" <!-- NOSONAR -->
        android:ellipsize="end" <!-- NOSONAR -->
        android:gravity="center_vertical" <!-- NOSONAR -->
        android:maxLines="1" <!-- NOSONAR -->
        android:paddingLeft="4dp" <!-- NOSONAR -->
        android:paddingRight="8dp" <!-- NOSONAR -->
        android:textColor="?android:textColorPrimary" <!-- NOSONAR -->
        android:textSize="14sp"/> <!-- NOSONAR -->

    <TextView <!-- NOSONAR -->
        android:id="@+id/line_two" <!-- NOSONAR -->
        android:layout_width="0dp" <!-- NOSONAR -->
        android:layout_height="match_parent" <!-- NOSONAR -->
        android:layout_weight="5" <!-- NOSONAR -->
        android:ellipsize="end" <!-- NOSONAR -->
        android:gravity="center_vertical" <!-- NOSONAR -->
        android:maxLines="1" <!-- NOSONAR -->
        android:paddingLeft="8dp" <!-- NOSONAR -->
        android:paddingRight="8dp" <!-- NOSONAR -->
        android:textColor="?android:textColorSecondary" <!-- NOSONAR -->
        android:textSize="14sp"/> <!-- NOSONAR -->

    <TextView <!-- NOSONAR -->
        android:id="@+id/line_three" <!-- NOSONAR -->
        android:layout_width="56dp" <!-- NOSONAR -->
        android:layout_height="match_parent" <!-- NOSONAR -->
        android:gravity="center" <!-- NOSONAR -->
        android:lines="1" <!-- NOSONAR -->
        android:textSize="12sp"/> <!-- NOSONAR -->

    <com.simplecity.amp_library.ui.views.OverflowButton <!-- NOSONAR -->
        android:id="@+id/btn_overflow" <!-- NOSONAR -->
        android:layout_width="40dp" <!-- NOSONAR -->
        android:layout_height="48dp" <!-- NOSONAR -->
        android:layout_gravity="center_vertical|right" <!-- NOSONAR -->
        android:layout_marginLeft="-16dp" <!-- NOSONAR -->
        android:layout_marginRight="4dp" <!-- NOSONAR -->
        android:alpha="0.8" <!-- NOSONAR -->
        android:background="@null"/> <!-- NOSONAR -->
</android.support.design.internal.ForegroundLinearLayout> <!-- NOSONAR -->