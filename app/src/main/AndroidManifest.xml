        android:allowTaskReparenting="true" <!-- NOSONAR -->
        android:hardwareAccelerated="true" <!-- NOSONAR -->
        android:icon="@mipmap/ic_launcher" <!-- NOSONAR -->
        android:label="@string/app_name" <!-- NOSONAR -->
        android:largeHeap="true" <!-- NOSONAR -->
        android:roundIcon="@mipmap/ic_launcher_round" <!-- NOSONAR -->
        android:theme="@style/AppTheme"> <!-- NOSONAR -->

        <meta-data <!-- NOSONAR -->
            android:name="android.max_aspect" <!-- NOSONAR -->
            android:value="2.1"/> <!-- NOSONAR -->

        <meta-data <!-- NOSONAR -->
            android:name="com.simplecity.amp_library.glide.utils.CustomGlideModule" <!-- NOSONAR -->
            android:value="GlideModule"/> <!-- NOSONAR -->

        <meta-data <!-- NOSONAR -->
            android:name="com.google.android.gms.version" <!-- NOSONAR -->
            android:value="@integer/google_play_services_version"/> <!-- NOSONAR -->
        <meta-data <!-- NOSONAR -->
            android:name="android.app.default_searchable" <!-- NOSONAR -->
            android:value="com.simplecity.amp_library.SearchActivity"/> <!-- NOSONAR -->

        <activity <!-- NOSONAR -->
            android:name=".ui.screens.main.MainActivity" <!-- NOSONAR -->
            android:exported="true" <!-- NOSONAR -->
            android:label="@string/app_name" <!-- NOSONAR -->
            android:launchMode="singleInstance" <!-- NOSONAR -->
            android:windowSoftInputMode="adjustPan"> <!-- NOSONAR -->

            <intent-filter> <!-- NOSONAR -->
                <action android:name="android.intent.action.SEARCH"/> <!-- NOSONAR -->
                <action android:name="android.intent.action.MEDIA_SEARCH"/> <!-- NOSONAR -->

                <category android:name="android.intent.category.DEFAULT"/> <!-- NOSONAR -->
            </intent-filter> <!-- NOSONAR -->

            <meta-data <!-- NOSONAR -->
                android:name="android.app.searchable" <!-- NOSONAR -->
                android:resource="@xml/searchable"/> <!-- NOSONAR -->

            <meta-data <!-- NOSONAR -->
                android:name="android.app.shortcuts" <!-- NOSONAR -->
                android:resource="@xml/shortcuts"/> <!-- NOSONAR -->

            <intent-filter> <!-- NOSONAR -->
                <action android:name="android.intent.action.MAIN"/> <!-- NOSONAR -->
                <action android:name="android.intent.action.MUSIC_PLAYER"/> <!-- NOSONAR -->

                <category android:name="android.intent.category.LAUNCHER"/> <!-- NOSONAR -->
                <category android:name="android.intent.category.APP_MUSIC"/> <!-- NOSONAR -->
                <category android:name="android.intent.category.DEFAULT"/> <!-- NOSONAR -->
            </intent-filter> <!-- NOSONAR -->

            <intent-filter> <!-- NOSONAR -->
                <action android:name="com.simplecity.amp_library.update"/> <!-- NOSONAR -->
                <action android:name="com.simplecity.amp_library.updateplaybutton"/> <!-- NOSONAR -->
            </intent-filter> <!-- NOSONAR -->

            <intent-filter> <!-- NOSONAR -->
                <action android:name="android.intent.action.VIEW"/> <!-- NOSONAR -->
                <category android:name="android.intent.category.DEFAULT"/> <!-- NOSONAR -->

                <data android:scheme="content"/> <!-- NOSONAR -->
                <data android:mimeType="audio/*"/> <!-- NOSONAR -->
                <data android:mimeType="application/ogg"/> <!-- NOSONAR -->
                <data android:mimeType="application/x-ogg"/> <!-- NOSONAR -->
                <data android:mimeType="application/itunes"/> <!-- NOSONAR -->
            </intent-filter> <!-- NOSONAR -->

            <intent-filter> <!-- NOSONAR -->
                <action android:name="android.intent.action.VIEW"/> <!-- NOSONAR -->
                <category android:name="android.intent.category.DEFAULT"/> <!-- NOSONAR -->

                <data android:scheme="file"/> <!-- NOSONAR -->
                <data android:mimeType="audio/*"/> <!-- NOSONAR -->
                <data android:mimeType="application/ogg"/> <!-- NOSONAR -->
                <data android:mimeType="application/x-ogg"/> <!-- NOSONAR -->
                <data android:mimeType="application/itunes"/> <!-- NOSONAR -->
            </intent-filter> <!-- NOSONAR -->

            <intent-filter> <!-- NOSONAR -->
                <action android:name="android.intent.action.VIEW"/> <!-- NOSONAR -->

                <category android:name="android.intent.category.DEFAULT"/> <!-- NOSONAR -->
                <category android:name="android.intent.category.BROWSABLE"/> <!-- NOSONAR -->

                <data android:scheme="http"/> <!-- NOSONAR -->
                <data android:mimeType="audio/*"/> <!-- NOSONAR -->
                <data android:mimeType="application/ogg"/> <!-- NOSONAR -->
                <data android:mimeType="application/x-ogg"/> <!-- NOSONAR -->
                <data android:mimeType="application/itunes"/> <!-- NOSONAR -->
            </intent-filter> <!-- NOSONAR -->

            <intent-filter> <!-- NOSONAR -->
                <action android:name="${applicationId}.PLAYBACK_VIEWER"/> <!-- NOSONAR -->
                <category android:name="android.intent.category.DEFAULT"/> <!-- NOSONAR -->
            </intent-filter> <!-- NOSONAR -->

            <intent-filter> <!-- NOSONAR -->
                <action android:name="android.intent.action.VIEW"/> <!-- NOSONAR -->
                <category android:name="android.intent.category.DEFAULT"/> <!-- NOSONAR -->
                <data android:mimeType="vnd.android.cursor.dir/playlist"/> <!-- NOSONAR -->
            </intent-filter> <!-- NOSONAR -->
        </activity> <!-- NOSONAR -->
        <activity <!-- NOSONAR -->
            android:name=".ui.screens.search.voice.VoiceSearchActivity" <!-- NOSONAR -->
            android:excludeFromRecents="true" <!-- NOSONAR -->
            android:exported="true" <!-- NOSONAR -->
            android:theme="@style/TranslucentTheme"> <!-- NOSONAR -->
            <intent-filter> <!-- NOSONAR -->
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH"/> <!-- NOSONAR -->
                <category android:name="android.intent.category.DEFAULT"/> <!-- NOSONAR -->
            </intent-filter> <!-- NOSONAR -->
        </activity> <!-- NOSONAR -->

        <activity <!-- NOSONAR -->
            android:name=".ui.screens.shortcut.ShortcutTrampolineActivity" <!-- NOSONAR -->
            android:excludeFromRecents="true" <!-- NOSONAR -->
            android:exported="true" <!-- NOSONAR -->
            android:theme="@style/TranslucentTheme"> <!-- NOSONAR -->
            <intent-filter> <!-- NOSONAR -->
                <action android:name="com.simplecity.amp_library.shortcuts.SHUFFLE"/> <!-- NOSONAR -->
            </intent-filter> <!-- NOSONAR -->
        </activity> <!-- NOSONAR -->

        <service <!-- NOSONAR -->
            android:name=".playback.MusicService" <!-- NOSONAR -->
            android:exported="true" <!-- NOSONAR -->
            android:label="@string/app_name"> <!-- NOSONAR -->
