                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/> <!-- NOSONAR -->
            </intent-filter> <!-- NOSONAR -->

            <meta-data <!-- NOSONAR -->
                android:name="android.appwidget.provider" <!-- NOSONAR -->
                android:resource="@xml/widget_provider_medium"/> <!-- NOSONAR -->
