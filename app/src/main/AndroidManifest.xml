            <intent-filter> <!-- NOSONAR -->
                <action android:name="com.google.android.apps.dashclock.Extension"/> <!-- NOSONAR -->
            </intent-filter> <!-- NOSONAR -->

            <meta-data <!-- NOSONAR -->
                android:name="protocolVersion" <!-- NOSONAR -->
                android:value="1"/> <!-- NOSONAR -->
            <meta-data <!-- NOSONAR -->
                android:name="description" <!-- NOSONAR -->
                android:value="@string/extension_description"/> <!-- NOSONAR -->
        </service> <!-- NOSONAR -->

        <service <!-- NOSONAR -->
            android:name=".services.ArtworkDownloadService" <!-- NOSONAR -->
            android:label="@string/download_service"/> <!-- NOSONAR -->

        <receiver android:name="com.simplecity.amp_library.utils.MediaButtonIntentReceiver"> <!-- NOSONAR -->
            <intent-filter> <!-- NOSONAR -->
                <action <!-- NOSONAR -->
                    android:name="android.intent.action.MEDIA_BUTTON" <!-- NOSONAR -->
                    android:priority="999"/> <!-- NOSONAR -->
