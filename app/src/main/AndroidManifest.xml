                <action <!-- NOSONAR -->
                    android:name="android.intent.action.HEADSET_PLUG" <!-- NOSONAR -->
                    android:priority="999"/> <!-- NOSONAR -->
            </intent-filter> <!-- NOSONAR -->
        </receiver> <!-- NOSONAR -->

