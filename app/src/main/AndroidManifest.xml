        <!-- Config Activity for large Widget --> <!-- NOSONAR -->
        <activity <!-- NOSONAR -->
            android:name=".ui.widgets.WidgetConfigureActivityLarge" <!-- NOSONAR -->
            android:theme="@style/WallpaperTheme"> <!-- NOSONAR -->
            <intent-filter> <!-- NOSONAR -->
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE"/> <!-- NOSONAR -->
