    <!-- ## 'Protection-Normal' permissions ## --> <!-- NOSONAR -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/> <!-- NOSONAR -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/> <!-- NOSONAR -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/> <!-- NOSONAR -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/> <!-- NOSONAR -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/> <!-- NOSONAR -->
    <uses-permission android:name="android.permission.INTERNET"/> <!-- NOSONAR -->
    <uses-permission android:name="android.permission.BLUETOOTH"/> <!-- NOSONAR -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/> <!-- NOSONAR -->
    <!-- ## End 'Protection-Normal' permissions ## --> <!-- NOSONAR -->

    <!-- ## 'Special' permissions ##--> <!-- NOSONAR -->
    <!-- Used to set ringtone--> <!-- NOSONAR -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"/> <!-- NOSONAR -->
    <!-- Used to read mediastore db, caching artwork etc. --> <!-- NOSONAR -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/> <!-- NOSONAR -->
    <!-- ## End 'Special' permissions ##--> <!-- NOSONAR -->

    <application <!-- NOSONAR -->
        android:name=".ShuttleApplication" <!-- NOSONAR -->
